---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Keep work-in-progress pages such as the design system out of search. */
  noindex?: boolean;
}

const {
  title,
  description = 'Azure Cloud Architecture, Cloud Adoption Framework and DevOps consultancy.',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} | CloudsInSight` : 'CloudsInSight';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#5cb8ff" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  .skip-link {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-md);
    background: var(--navy-900);
    color: var(--white);
    font-weight: var(--weight-semibold);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
