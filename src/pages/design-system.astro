---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Callout from '../components/Callout.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import { approach } from '../data/site';

const brand = [
  { name: 'Sky 400', token: '--sky-400', hex: '#5CB8FF', note: 'Logo blue. Backgrounds with navy text.' },
  { name: 'Teal 300', token: '--teal-300', hex: '#60CDDD', note: 'Logo accent. Rules, markers, decoration.' },
  { name: 'Navy 900', token: '--navy-900', hex: '#0B2545', note: 'Text, footer, inverse sections.' },
  { name: 'Sky 700', token: '--sky-700', hex: '#1466AD', note: 'Links and primary buttons.' },
  { name: 'Teal 800', token: '--teal-800', hex: '#176A77', note: 'Eyebrows and accent text.' },
];

const scales = {
  sky: ['50', '100', '200', '300', '400', '500', '600', '700', '800', '900'],
  teal: ['50', '100', '300', '600', '700', '800'],
  navy: ['700', '800', '900', '950'],
  slate: ['50', '100', '200', '300', '400', '500', '600', '700'],
};

const typeScale = [
  ['--text-4xl', 'Display / H1', 'Architecture you can explain'],
  ['--text-3xl', 'H2', 'Cloud Adoption Framework'],
  ['--text-2xl', 'Article H2', 'Structuring Terraform for Azure'],
  ['--text-xl', 'H3 / card title', 'Landing Zone implementation'],
  ['--text-lg', 'Lead', 'Pragmatic decisions, documented trade-offs.'],
  ['--text-base', 'Body', 'Body copy is set at 17px with a 1.6 line height.'],
  ['--text-sm', 'Small / UI', 'Navigation, buttons, metadata.'],
  ['--text-xs', 'Badge', 'Tags and labels.'],
];

const spaces = ['1', '2', '3', '4', '6', '8', '12', '16', '24'];

---

<BaseLayout title="Design system" description="CloudsInSight design tokens and components." noindex>
  <Section tone="tint">
    <p class="eyebrow">Internal reference</p>
    <h1 class="ds-title">Design system</h1>
    <p class="lead">
      Tokens and components for cloudsinsight.be. Plain CSS custom properties and Astro components,
      no framework. Source lives in <code>src/styles</code> and <code>src/components</code>.
    </p>
  </Section>

  <!-- Logo -->
  <Section>
    <SectionHeader eyebrow="01" title="Logo">
      The original logo sits on the brand blue. For the site the background is removed and the white
      linework becomes navy, so the logo works on white.
    </SectionHeader>
    <div class="grid ds-logos">
      <figure class="ds-logo ds-logo--light"><Logo height={44} /><figcaption>Horizontal, header</figcaption></figure>
      <figure class="ds-logo ds-logo--dark"><Logo inverse height={44} /><figcaption>Horizontal inverse, footer</figcaption></figure>
      <figure class="ds-logo ds-logo--light"><Logo variant="stacked" height={120} /><figcaption>Stacked</figcaption></figure>
      <figure class="ds-logo ds-logo--brand"><Logo variant="mark" height={80} /><figcaption>Mark on brand blue</figcaption></figure>
    </div>
  </Section>

  <!-- Colour -->
  <Section tone="subtle">
    <SectionHeader eyebrow="02" title="Colour">
      White text on the logo blue fails contrast (2.2:1), so the blue is a surface for navy text (7.2:1).
      Interactive colour is the darker Sky 700 (5.9:1 on white).
    </SectionHeader>
    <div class="grid ds-brand" style="--grid-min: 12rem">
      {
        brand.map((c) => (
          <div class="ds-swatch">
            <div class="ds-swatch__chip" style={`background: var(${c.token})`} />
            <div class="ds-swatch__meta">
              <strong>{c.name}</strong>
              <code>{c.hex}</code>
              <span>{c.note}</span>
            </div>
          </div>
        ))
      }
    </div>

    {
      Object.entries(scales).map(([name, steps]) => (
        <div class="ds-scale">
          <h3 class="ds-scale__name">{name}</h3>
          <div class="ds-scale__row">
            {steps.map((s) => (
              <div class="ds-scale__step">
                <div class="ds-scale__chip" style={`background: var(--${name}-${s})`} />
                <code>{s}</code>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </Section>

  <!-- Typography -->
  <Section>
    <SectionHeader eyebrow="03" title="Typography">
      Inter for headings and body, a system monospace for code. The slab serif stays in the logo.
    </SectionHeader>
    <dl class="ds-type">
      {
        typeScale.map(([token, label, sample]) => (
          <div class="ds-type__row">
            <dt>
              <strong>{label}</strong>
              <code>{token}</code>
            </dt>
            <dd style={`font-size: var(${token}); font-weight: ${token.match(/(4xl|3xl|2xl|xl)$/) ? 700 : 400}; letter-spacing: ${token.match(/(4xl|3xl|2xl)$/) ? 'var(--tracking-tight)' : 'normal'}`}>
              {sample}
            </dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <!-- Space -->
  <Section tone="subtle">
    <SectionHeader eyebrow="04" title="Spacing and shape">
      A 4px base scale. Sections use the fluid <code>--section-space</code>; page edges use <code>--gutter</code>.
    </SectionHeader>
    <div class="ds-space">
      {
        spaces.map((s) => (
          <div class="ds-space__row">
            <code>--space-{s}</code>
            <span class="ds-space__bar" style={`width: var(--space-${s})`} />
          </div>
        ))
      }
    </div>
    <div class="ds-radii">
      <div style="border-radius: var(--radius-sm)">radius-sm</div>
      <div style="border-radius: var(--radius-md)">radius-md</div>
      <div style="border-radius: var(--radius-lg)">radius-lg</div>
      <div style="border-radius: var(--radius-lg); box-shadow: var(--shadow-md)">shadow-md</div>
    </div>
  </Section>

  <!-- Components -->
  <Section>
    <SectionHeader eyebrow="05" title="Buttons, badges and icons" />
    <div class="ds-row">
      <Button href="#">Get in touch</Button>
      <Button href="#" variant="secondary">View services</Button>
      <Button href="#" variant="ghost">Read the blog <Icon name="arrowRight" size={16} /></Button>
      <Button size="lg">Large primary</Button>
    </div>
    <div class="ds-row">
      <Badge>Terraform</Badge>
      <Badge tone="brand">Azure</Badge>
      <Badge tone="accent">Landing Zones</Badge>
      <Badge href="#">Linked tag</Badge>
    </div>
    <div class="ds-row ds-icons">
      <Icon name="architecture" />
      <Icon name="framework" />
      <Icon name="code" />
      <Icon name="cloud" />
      <Icon name="shield" />
      <Icon name="mail" />
      <Icon name="linkedin" />
      <Icon name="arrowRight" />
    </div>
  </Section>

  <Section tone="subtle">
    <SectionHeader eyebrow="06" title="Cards">
      Service cards for Home and Services. With <code>href</code> the whole card is clickable.
    </SectionHeader>
    <div class="grid">
      <Card title="Azure Cloud Architecture" href="#">
        <Icon slot="icon" name="architecture" />
        <p>Landing zones, governance, identity, networking and security designed to fit how you actually operate.</p>
        <span slot="footer">Explore architecture →</span>
      </Card>
      <Card title="Cloud Adoption Framework" href="#">
        <Icon slot="icon" name="framework" />
        <p>CAF assessments, gap analysis and risk identification that end in a prioritised plan, not a slide deck.</p>
        <span slot="footer">Explore CAF →</span>
      </Card>
      <Card title="DevOps & Infrastructure as Code" href="#">
        <Icon slot="icon" name="code" />
        <p>Terraform, Bicep and CI/CD on GitHub or Azure DevOps, built so your team can own and extend it.</p>
        <span slot="footer">Explore DevOps →</span>
      </Card>
    </div>
  </Section>

  <Section>
    <SectionHeader eyebrow="07" title="Process steps">
      For the Approach page and the home page summary.
    </SectionHeader>
    <ProcessSteps steps={approach} />
  </Section>

  <!-- Section tones -->
  <Section tone="tint">
    <SectionHeader eyebrow="08 · Section tones" title="Tint">Light sky background for alternating sections.</SectionHeader>
  </Section>
  <Section tone="brand">
    <SectionHeader eyebrow="Brand" title="Planning a landing zone?">
      The logo blue, with navy text. Use once or twice per page for calls to action.
    </SectionHeader>
    <div class="ds-row"><Button href="#" variant="inverse">Get in touch</Button></div>
  </Section>
  <Section tone="inverse">
    <SectionHeader eyebrow="Inverse" title="Navy">
      For emphasis and the footer. Links switch to <a href="#">light sky</a> automatically.
    </SectionHeader>
    <div class="ds-row"><Button href="#" variant="inverse">Get in touch</Button></div>
  </Section>

  <!-- Prose -->
  <Section>
    <SectionHeader eyebrow="09" title="Article prose">
      Wrap rendered Markdown in <code>.prose</code>. Measure is capped at 68 characters.
    </SectionHeader>
    <div class="ds-meta">
      <Badge tone="brand">Azure</Badge>
      <Badge tone="accent">Terraform</Badge>
      <span class="muted">Published 11 October 2026 · 6 min read</span>
    </div>
    <article class="prose">
      <p>
        Most Azure Landing Zone problems are not caused by the reference architecture. They come from
        decisions that were never written down. This is a sample paragraph with <a href="#">an inline link</a>
        and some <code>inline_code()</code>.
      </p>
      <h2>Structure state by blast radius</h2>
      <p>Split Terraform state along the lines of who changes what, and how often:</p>
      <ul>
        <li>Platform: management groups, policy, connectivity.</li>
        <li>Landing zones: one state per subscription.</li>
        <li>Workloads: owned by application teams.</li>
      </ul>
      <pre><code>module "landing_zone" &#123;
  source          = "./modules/landing-zone"
  subscription_id = var.subscription_id
  address_space   = ["10.20.0.0/16"]
&#125;</code></pre>
      <blockquote>Deterministic checks stay authoritative. AI is an input to the decision, not the decision.</blockquote>
      <Callout type="tip">Pin provider versions in every root module, not just the shared ones.</Callout>
      <Callout type="warning" title="Cost">Azure Firewall Premium in every spoke adds up quickly.</Callout>
      <table>
        <thead><tr><th>Option</th><th>Pros</th><th>Cons</th></tr></thead>
        <tbody>
          <tr><td>Hub and spoke</td><td>Familiar, flexible</td><td>More to operate</td></tr>
          <tr><td>Virtual WAN</td><td>Managed routing</td><td>Less control</td></tr>
        </tbody>
      </table>
    </article>
  </Section>
</BaseLayout>

<style>
  .ds-title {
    margin-block: var(--space-3) var(--space-4);
  }

  .ds-logos {
    --grid-min: 15rem;
  }

  .ds-logo {
    display: grid;
    gap: var(--space-4);
    place-items: center;
    padding: var(--space-8) var(--space-6) var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .ds-logo figcaption {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .ds-logo--dark {
    background: var(--navy-900);
  }

  .ds-logo--dark figcaption {
    color: var(--slate-300);
  }

  .ds-logo--brand {
    background: var(--sky-400);
  }

  .ds-logo--brand figcaption {
    color: var(--navy-900);
  }

  .ds-swatch {
    overflow: hidden;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .ds-swatch__chip {
    height: 5rem;
  }

  .ds-swatch__meta {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-4);
    font-size: var(--text-sm);
  }

  .ds-swatch__meta span {
    color: var(--color-text-muted);
  }

  .ds-scale {
    margin-top: var(--space-10);
  }

  .ds-scale__name {
    margin-bottom: var(--space-3);
    font-size: var(--text-sm);
    text-transform: capitalize;
  }

  .ds-scale__row {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(4.5rem, 1fr));
    gap: var(--space-2);
  }

  .ds-scale__step {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-xs);
  }

  .ds-scale__chip {
    height: 3rem;
    border: var(--border-width) solid rgb(11 37 69 / 0.08);
    border-radius: var(--radius-md);
  }

  .ds-type__row {
    display: grid;
    grid-template-columns: minmax(10rem, 14rem) 1fr;
    gap: var(--space-2) var(--space-6);
    align-items: baseline;
    padding-block: var(--space-5);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .ds-type dt {
    display: grid;
    font-size: var(--text-sm);
  }

  .ds-type dt code {
    color: var(--color-text-subtle);
  }

  .ds-type dd {
    line-height: var(--leading-tight);
  }

  @media (max-width: 40rem) {
    .ds-type__row {
      grid-template-columns: 1fr;
    }
  }

  .ds-space {
    display: grid;
    gap: var(--space-2);
  }

  .ds-space__row {
    display: grid;
    grid-template-columns: 7rem 1fr;
    align-items: center;
    font-size: var(--text-sm);
  }

  .ds-space__bar {
    height: 1rem;
    border-radius: 2px;
    background: var(--teal-300);
  }

  .ds-radii {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-top: var(--space-10);
  }

  .ds-radii div {
    display: grid;
    place-items: center;
    width: 8rem;
    height: 5rem;
    border: var(--border-width) solid var(--color-border-strong);
    background: var(--color-bg);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
  }

  .ds-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .ds-row + .ds-row {
    margin-top: var(--space-6);
  }

  .ds-icons {
    color: var(--color-accent-strong);
  }

  .ds-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }
</style>
