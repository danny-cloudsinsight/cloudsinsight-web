---
import Logo from './Logo.astro';
import { company } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container container--wide site-footer__inner">
    <div class="site-footer__brand">
      <Logo inverse height={30} />
      <p>Azure architecture, Cloud Adoption Framework and DevOps.</p>
      <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
    </div>

    <nav aria-label="Footer">
      <ul class="site-footer__links">
        <li><a href="/services">Services</a></li>
        <li><a href="/approach">Approach</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/contact">Contact</a></li>
      </ul>
    </nav>
  </div>
  <div class="container container--wide site-footer__legal">
    <p>© {year} {company.name} · VAT {company.vat}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: var(--space-16);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse-muted);
    font-size: var(--text-sm);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
  }

  .site-footer__brand {
    display: grid;
    gap: var(--space-4);
    max-width: 22rem;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    padding: 0;
    list-style: none;
  }

  .site-footer a {
    color: var(--white);
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--teal-300);
    text-decoration: underline;
  }

  .site-footer__legal {
    padding-block: var(--space-6);
    border-top: var(--border-width) solid var(--navy-700);
  }
</style>
