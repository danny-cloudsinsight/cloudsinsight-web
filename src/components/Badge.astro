---
interface Props {
  tone?: 'neutral' | 'brand' | 'accent';
  href?: string;
}

const { tone = 'neutral', href } = Astro.props;
const Tag = href ? 'a' : 'span';
---

<Tag href={href} class:list={['badge', `badge--${tone}`]}><slot /></Tag>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.2em 0.7em;
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
  }

  .badge--neutral {
    background: var(--slate-100);
    color: var(--slate-700);
  }

  .badge--brand {
    background: var(--sky-100);
    color: var(--sky-800);
  }

  .badge--accent {
    background: var(--teal-100);
    color: var(--teal-800);
  }

  a.badge:hover {
    text-decoration: underline;
  }
</style>
