---
interface Props {
  title: string;
  /** Makes the whole card a link. */
  href?: string;
  eyebrow?: string;
  /** Slot "icon" renders above the title. */
  as?: 'h2' | 'h3' | 'h4';
}

const { title, href, eyebrow, as: Heading = 'h3' } = Astro.props;
---

<article class:list={['card', href && 'card--link']}>
  {Astro.slots.has('icon') && <div class="card__icon"><slot name="icon" /></div>}
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Heading class="card__title">
    {href ? <a href={href}>{title}</a> : title}
  </Heading>
  <div class="card__body"><slot /></div>
  {Astro.slots.has('footer') && <div class="card__footer"><slot name="footer" /></div>}
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    color: var(--color-text);
    transition:
      border-color var(--duration-base) var(--ease),
      box-shadow var(--duration-base) var(--ease);
  }

  .card__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }

  .card__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .card__title {
    font-size: var(--text-xl);
  }

  .card__title a {
    color: inherit;
    text-decoration: none;
  }

  /* Stretch the title link over the whole card */
  .card--link .card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .card--link:hover {
    border-color: var(--sky-300);
    box-shadow: var(--shadow-md);
  }

  .card--link:focus-within {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .card--link .card__title a:focus-visible {
    outline: none;
  }

  .card__body {
    color: var(--color-text-muted);
  }

  .card__body :global(ul) {
    padding-left: var(--space-5);
  }

  .card__footer {
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-link);
  }
</style>
